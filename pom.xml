<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<groupId>Eternity</groupId>
    <artifactId>EternityTTRPG</artifactId>
    <version>0.2</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
        <app.display.name>EternityLauncher</app.display.name>
        <app.vendor>Eternity</app.vendor>
        <windows.install.dir>EternityLauncher</windows.install.dir>
        <windows.jpackage.input.dir>${project.build.directory}/jpackage-input-${maven.build.timestamp}</windows.jpackage.input.dir>
        <windows.appimage.dir>${project.build.directory}/dist-${maven.build.timestamp}</windows.appimage.dir>
        <windows.installer.dir>${project.build.directory}/installer-${maven.build.timestamp}</windows.installer.dir>
        <macos.jpackage.input.dir>${project.build.directory}/mac-jpackage-input-${maven.build.timestamp}</macos.jpackage.input.dir>
        <macos.appimage.dir>${project.build.directory}/mac-dist-${maven.build.timestamp}</macos.appimage.dir>
        <macos.installer.dir>${project.build.directory}/mac-installer-${maven.build.timestamp}</macos.installer.dir>
    </properties>

    <dependencies>	
		<dependency>
    		<groupId>com.fasterxml.jackson.core</groupId>
    		<artifactId>jackson-databind</artifactId>
    		<version>2.9.0.pr2</version>
		</dependency>
		<dependency>
    		<groupId>com.fasterxml.jackson.datatype</groupId>
    		<artifactId>jackson-datatype-jsr310</artifactId>
    		<version>2.9.0.pr2</version>
		</dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.6</version>
        </dependency>
	</dependencies>

    <build>
        <finalName>EternityTTRPG</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>shade-app</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/EternityTTRPG.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>eternity.EternityMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                    <execution>
                        <id>shade-launcher</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/EternityLauncher.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>launcher.EternityLauncherMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-exe</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <phase>package</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${windows.jpackage.input.dir}"/>
                                        <copy file="${project.build.directory}/EternityLauncher.jar"
                                              tofile="${windows.jpackage.input.dir}/EternityLauncher.jar"/>
                                        <copy file="${project.build.directory}/EternityTTRPG.jar"
                                              tofile="${windows.jpackage.input.dir}/EternityTTRPG.jar"/>
                                        <copy todir="${windows.jpackage.input.dir}/Data">
                                            <fileset dir="${project.basedir}/Data"/>
                                        </copy>
                                        <copy todir="${windows.jpackage.input.dir}/Images">
                                            <fileset dir="${project.basedir}/Images"/>
                                        </copy>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.display.name}</argument>
                                        <argument>--input</argument>
                                        <argument>${windows.jpackage.input.dir}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>EternityLauncher.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>launcher.EternityLauncherMain</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>EternityTTRPG=${project.build.outputDirectory}/eternity-main-launcher.properties</argument>
                                        <argument>--dest</argument>
                                        <argument>${windows.appimage.dir}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.vendor}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--install-dir</argument>
                                        <argument>${windows.install.dir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-installer-input</id>
                                <phase>package</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${windows.jpackage.input.dir}"/>
                                        <copy file="${project.build.directory}/EternityLauncher.jar"
                                              tofile="${windows.jpackage.input.dir}/EternityLauncher.jar"/>
                                        <copy file="${project.build.directory}/EternityTTRPG.jar"
                                              tofile="${windows.jpackage.input.dir}/EternityTTRPG.jar"/>
                                        <copy todir="${windows.jpackage.input.dir}/Data">
                                            <fileset dir="${project.basedir}/Data"/>
                                        </copy>
                                        <copy todir="${windows.jpackage.input.dir}/Images">
                                            <fileset dir="${project.basedir}/Images"/>
                                        </copy>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-windows-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--name</argument>
                                        <argument>${app.display.name}</argument>
                                        <argument>--input</argument>
                                        <argument>${windows.jpackage.input.dir}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>EternityLauncher.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>launcher.EternityLauncherMain</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>EternityTTRPG=${project.build.outputDirectory}/eternity-main-launcher.properties</argument>
                                        <argument>--dest</argument>
                                        <argument>${windows.installer.dir}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.vendor}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--install-dir</argument>
                                        <argument>${windows.install.dir}</argument>
                                        <argument>--win-dir-chooser</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>macos-app</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-macos-app-input</id>
                                <phase>package</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${macos.jpackage.input.dir}"/>
                                        <copy file="${project.build.directory}/EternityLauncher.jar"
                                              tofile="${macos.jpackage.input.dir}/EternityLauncher.jar"/>
                                        <copy file="${project.build.directory}/EternityTTRPG.jar"
                                              tofile="${macos.jpackage.input.dir}/EternityTTRPG.jar"/>
                                        <copy todir="${macos.jpackage.input.dir}/Data">
                                            <fileset dir="${project.basedir}/Data"/>
                                        </copy>
                                        <copy todir="${macos.jpackage.input.dir}/Images">
                                            <fileset dir="${project.basedir}/Images"/>
                                        </copy>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-macos-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>EternityLauncher</argument>
                                        <argument>--input</argument>
                                        <argument>${macos.jpackage.input.dir}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>EternityLauncher.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>launcher.EternityLauncherMain</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>EternityTTRPG=${project.build.outputDirectory}/eternity-main-launcher.properties</argument>
                                        <argument>--dest</argument>
                                        <argument>${macos.appimage.dir}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Eternity</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>macos-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-macos-installer-input</id>
                                <phase>package</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${macos.jpackage.input.dir}"/>
                                        <copy file="${project.build.directory}/EternityLauncher.jar"
                                              tofile="${macos.jpackage.input.dir}/EternityLauncher.jar"/>
                                        <copy file="${project.build.directory}/EternityTTRPG.jar"
                                              tofile="${macos.jpackage.input.dir}/EternityTTRPG.jar"/>
                                        <copy todir="${macos.jpackage.input.dir}/Data">
                                            <fileset dir="${project.basedir}/Data"/>
                                        </copy>
                                        <copy todir="${macos.jpackage.input.dir}/Images">
                                            <fileset dir="${project.basedir}/Images"/>
                                        </copy>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-macos-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>dmg</argument>
                                        <argument>--name</argument>
                                        <argument>EternityLauncher</argument>
                                        <argument>--input</argument>
                                        <argument>${macos.jpackage.input.dir}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>EternityLauncher.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>launcher.EternityLauncherMain</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>EternityTTRPG=${project.build.outputDirectory}/eternity-main-launcher.properties</argument>
                                        <argument>--dest</argument>
                                        <argument>${macos.installer.dir}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Eternity</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
